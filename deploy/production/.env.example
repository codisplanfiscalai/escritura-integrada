# Exemplo. Prefira o pacote gerado da release: ele já traz .env com imagens publicadas.
COMPOSE_PROJECT_NAME=escritura-production
ESCRITURA_BIND=127.0.0.1
ESCRITURA_PORT=8000
ESCRITURA_IMAGE=ghcr.io/codisplanfiscalai/escritura-integrada:SUBSTITUA_PELA_TAG_DA_RELEASE
ESCRITURA_COOKIE_SECURE=0

# Perfis abaixo são opcionais e ainda não são consumidos pelo aplicativo (SQLite).
REDIS_IMAGE=ghcr.io/codisplanfiscalai/escritura-integrada-redis:8.2.11-bookworm-d5e51585d63aa5e7
POSTGRES_IMAGE=ghcr.io/codisplanfiscalai/escritura-integrada-postgres:17.11-bookworm-479e959b5363ce7a
MYSQL_IMAGE=ghcr.io/codisplanfiscalai/escritura-integrada-mysql:8.4.13-oraclelinux9-4d750207bb38a629
MINIO_IMAGE=ghcr.io/codisplanfiscalai/escritura-integrada-minio:RELEASE.2025-10-15T17-29-55Z-e7a72c13ff591acc

# Deixe vazios para app-only. Ao ativar um perfil, preencha seus segredos.
REDIS_PASSWORD=
POSTGRES_DB=escritura
POSTGRES_USER=escritura
POSTGRES_PASSWORD=
MYSQL_DATABASE=escritura
MYSQL_USER=escritura
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
